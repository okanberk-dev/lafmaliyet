+export const DUMMY_TAX_NUMBERS: ReadonlySet<string> = new Set([
+  "1234567890",
+  "1111111111",
+  "11111111111",
+  "2222222222",
+  "22222222222",
+  "0000000000",
+  "00000000000",
+  "9999999999",
+  "99999999999",
+]);
