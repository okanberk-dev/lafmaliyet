# Postgres bağlantısı. Vercel + Neon entegrasyonu DATABASE_URL'i otomatik ekler.
DATABASE_URL=postgres://kullanici:parola@host/veritabani?sslmode=require
# Migration için havuzsuz bağlantı. Neon entegrasyonu otomatik ekler, yoksa DATABASE_URL kullanılır.
DATABASE_URL_UNPOOLED=

# Oturum çerezlerini imzalamak için en az 32 karakterlik rastgele bir değer.
# Üretmek için: openssl rand -base64 48
AUTH_SECRET=

# İlk yönetici hesabı. Veritabanında hiç kullanıcı yokken oluşturulur.
ADMIN_EMAIL=admin@laffogato.net
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici

# Panelin adresi (e-postalardaki bağlantılar için)
APP_URL=https://ladmin.laffogato.net

# ---- E-posta (Resend) — laffogato.net sitesiyle aynı hesap; alan adı Resend'de doğrulanmış
# Yalnız sunucuda; NEXT_PUBLIC_ ile başlatmayın. Ayrıntı: docs/BILDIRIMLER.md
RESEND_API_KEY=
# İsteğe bağlı gönderen; panelde (Ödemeler & hatırlatıcılar → Gönderim ayarları) değiştirilebilir
EMAIL_FROM=L'Affogato Panel <bildirim@laffogato.net>
# İsteğe bağlı: kasa raporunun alıcıları, yönetici panelden (Kasa › Ayarlar) hiç kaydetmediyse; virgülle ayrılmış.
# Yerelde boş bırakın: gerçek kişilere deneme raporu gitmesin. Ayrıntı: docs/KASA-RAPORU.md
CASH_REPORT_RECIPIENTS=

# ---- Günlük işler (Vercel Cron): Paraşüt eşitlemesi 07:00–08:00, hatırlatma e-postası 08:00–09:00 (TR saati)
# Vercel bu değeri "Authorization: Bearer ..." başlığıyla gönderir. Üretmek için: openssl rand -hex 32
CRON_SECRET=

# ---- Paraşüt API v4 (gider faturalarını otomatik çekmek için). Ayrıntı: docs/PARASUT.md
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# İlk eşitlemede bu tarihten itibaren alınır (YYYY-MM-DD); boşsa içinde bulunulan yılın başı
PARASUT_SYNC_FROM=

# ---- laffogato.net bağlantısı: karaoke (docs/KARAOKE.md), menü (docs/SITE-MENU.md), uygulama siparişleri
# (docs/SITE-SIPARIS.md) ve online satışlar (docs/SITE-SATIS.md)
# Site her karaoke, menü ve sipariş değişikliğinde panele imzalı ping atar, panel rezervasyonları, menüyü, açık
# siparişleri ve aylık online satışı imzalı çeker; siteye bağlı ürünün fiyatı ve Satışta / Tükendi durumu panelde
# değişince önce siteye yazılır.
# laffogato.net projesindeki KARAOKE_SYNC_SECRET ile AYNI değer; en az 32 karakter: openssl rand -base64 48
# Boşsa bağlantı kapalı (hızlı sayaç çalışır, ürünler yalnız panelde; sipariş ve online satış görünmez).
KARAOKE_SYNC_SECRET=
# Sitenin adresi; boşsa https://laffogato.net
# LAFFOGATO_URL=https://laffogato.net

# ---- LafPOS bağlantısı (kafenin kasası; docs/LAFPOS.md): LafPOS gün sonunda günün satışını ve Z'sini imzalı iter
# (POST /api/pos/gun), ürün maliyetlerini imzalı okur (GET /api/panel/pos/urunler).
# LafPOS'taki LAFMALIYET_SYNC_SECRET ile AYNI değer; sitenin anahtarından (KARAOKE_SYNC_SECRET) ayrı olmalı.
# En az 32 karakter: openssl rand -base64 48. Boşsa iki uç da 503 döner.
LAFPOS_SYNC_SECRET=

# ---- ModPOS (Gafdigi) Kasa Föyü API (docs/MODPOS-API.md): panel her sabah dünün kasa föyünü çeker (günde 2 istek hakkı).
# Yalnız Production'a, yalnız sunucuda; depoya, sohbete yazmayın. Anahtara IP kısıtı koydurmayın (Vercel'in sabit IP'si yok).
# Boşsa bağlantı kapalı, hiçbir istek gitmez. Yerelde tanımlarsanız canlının günlük hakkından yer: boş bırakın.
MODPOS_API_KEY=
# İsteğe bağlı: geçmiş föylerin geriye doğru tamamlanacağı ilk gün (YYYY-MM-DD); boşsa 2026-07-01
# MODPOS_SYNC_FROM=2026-07-01
# İsteğe bağlı: ucun adresi; boşsa belgedeki adres
# MODPOS_API_URL=https://api.gafdigi.com/api/v2/external/raporlar/kasa-foyu

# ---- Web Push (isteğe bağlı): boşsa anahtarlar ilk kullanımda üretilip veritabanında şifreli saklanır
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://ladmin.laffogato.net

# ---- Claude bağlantısı (isteğe bağlı; docs/CLAUDE-BAGLANTISI.md). Önizlemelerde (VERCEL_ENV=preview) zaten kapalı.
# 1: bütün uçlar kapalı (404), verilmiş anahtarlar çalışmaz
# MCP_DISABLED=1
# 1: Claude Code / MCP Inspector'ın localhost dönüşüne canlıda da izin (yerelde zaten açık)
# MCP_ALLOW_LOCALHOST=1

# ---- Satış tahmini (isteğe bağlı; docs/SATIS-TAHMINI.md): MET Norway hava durumu isteğinin kimliğine eklenen iletişim
# (e-posta ya da adres). Boşsa yalnız uygulamanın adı ve APP_URL gider. Anahtar gerekmez.
# WEATHER_CONTACT=bildirim@laffogato.net
