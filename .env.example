# Postgres bağlantısı. Vercel + Neon entegrasyonu DATABASE_URL'i otomatik ekler.
DATABASE_URL=postgres://kullanici:parola@host/veritabani?sslmode=require
# Migration için havuzsuz bağlantı. Neon entegrasyonu otomatik ekler, yoksa DATABASE_URL kullanılır.
DATABASE_URL_UNPOOLED=

# Oturum çerezlerini imzalamak için en az 32 karakterlik rastgele bir değer.
# Üretmek için: openssl rand -base64 48
AUTH_SECRET=

# İlk yönetici hesabı. Veritabanında hiç kullanıcı yokken oluşturulur.
ADMIN_EMAIL=admin@laffogato.net
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici
